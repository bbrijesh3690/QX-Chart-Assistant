{
  "manifest_version": 3,
  "name": "QX Chart Assistant (Instant History)",
  "version": "1.2.7",
  "description": "Read-only multi-timeframe analysis assistant with guaranteed MAIN-world startup hook.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.quotex.com/*",
    "*://*.qxbroker.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.quotex.com/*",
        "*://*.qxbroker.com/*"
      ],
      "js": ["page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.quotex.com/*",
        "*://*.qxbroker.com/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_start"
    }
  ]
}
