{
  "manifest_version": 3,
  "name": "QX Chart Assistant",
  "version": "1.3.5",
  "description": "Read-only multi-timeframe assistant with zero-fallback tab detection and active history pipeline.",
  "permissions": ["storage"],
  "host_permissions": [
    "*://*.quotex.com/*",
    "*://*.qxbroker.com/*",
    "*://*.qxplus.com/*",
    "*://*.market-qx.pro/*",
    "*://*.broker-qx.pro/*",
    "*://*.quotex-market.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.quotex.com/*",
        "*://*.qxbroker.com/*",
        "*://*.qxplus.com/*",
        "*://*.market-qx.pro/*",
        "*://*.broker-qx.pro/*",
        "*://*.quotex-market.com/*"
      ],
      "js": ["page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.quotex.com/*",
        "*://*.qxbroker.com/*",
        "*://*.qxplus.com/*",
        "*://*.market-qx.pro/*",
        "*://*.broker-qx.pro/*",
        "*://*.quotex-market.com/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_start"
    }
  ]
}