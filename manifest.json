{
  "manifest_version": 3,
  "name": "QX Chart Assistant",
  "version": "1.4.40",
  "description": "FROZEN PLATFORM BASELINE v1.4.40 | STRATEGY v1.0.0-classic5pt: Scoped asset detection, atomic multi-window sync, and native OpenXML export.",
  "permissions": ["storage"],
  "host_permissions": [
    "*://*.quotex.com/*",
    "*://*.qxbroker.com/*",
    "*://*.qxplus.com/*",
    "*://*.market-qx.pro/*",
    "*://*.broker-qx.pro/*",
    "*://*.quotex-market.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.quotex.com/*",
        "*://*.qxbroker.com/*",
        "*://*.qxplus.com/*",
        "*://*.market-qx.pro/*",
        "*://*.broker-qx.pro/*",
        "*://*.quotex-market.com/*"
      ],
      "js": ["page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.quotex.com/*",
        "*://*.qxbroker.com/*",
        "*://*.qxplus.com/*",
        "*://*.market-qx.pro/*",
        "*://*.broker-qx.pro/*",
        "*://*.quotex-market.com/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_start"
    }
  ]
}